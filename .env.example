# 复制为 .env 后按需修改。留空 llm_base_url 时走离线确定性实现。
MOOKI_LLM_OFFLINE=true
MOOKI_LLM_BASE_URL=
MOOKI_LLM_API_KEY=
MOOKI_LLM_MODEL=qwen-plus

MOOKI_EMBED_BACKEND=lsa
MOOKI_EMBED_BASE_URL=
MOOKI_EMBED_API_KEY=
MOOKI_EMBED_MODEL=text-embedding-3-small
MOOKI_EMBED_DIM=128

# 留空用进程内 KV；填 redis://127.0.0.1:6379/0 切 Redis
MOOKI_REDIS_URL=
# local | chroma
MOOKI_VECTOR_BACKEND=local

MOOKI_RRF_K=60
MOOKI_BM25_TOP_K=20
MOOKI_DENSE_TOP_K=20
MOOKI_RERANK_TOP_K=5
MOOKI_CHUNK_SIZE=420
MOOKI_CHUNK_OVERLAP=70

MOOKI_MAX_TOOL_ITERATIONS=3
MOOKI_INTENT_MARGIN_THRESHOLD=0.12
MOOKI_CONTEXT_BUDGET_TOKENS=1200
MOOKI_SHORT_TERM_WINDOW=8

# 意图三路权重：不填则按「离线替身 / 真实模型」自动选一组标定好的默认值。
# 换模型后建议跑 `make eval-intent-online` 重新校一遍，再填在这里。
# MOOKI_INTENT_WEIGHT_LLM=0.55
# MOOKI_INTENT_WEIGHT_DENSE=0.05
# MOOKI_INTENT_WEIGHT_RULE=0.40

# 转人工是否真的挂起等人工接管（需要 langgraph）。开启后 P0/明确要求人工的会话
# 会停在 interrupt，由 /api/handoff/resume 送回答复。
MOOKI_ENABLE_HUMAN_INTERRUPT=false

# 成本估算单价（元 / 千 token），留 0 表示不估算
MOOKI_PRICE_IN_PER_1K=0
MOOKI_PRICE_OUT_PER_1K=0
